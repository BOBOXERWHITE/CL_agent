APP_NAME=Travel Ops Copilot API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

POSTGRES_DB=travel_ops
POSTGRES_USER=travel_ops
POSTGRES_PASSWORD=travel_ops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://travel_ops:travel_ops@localhost:5432/travel_ops

REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=knowledge
MINIO_SECURE=false

ETCD_PORT=2379
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
VECTOR_STORE_PROVIDER=milvus
MILVUS_HOST=localhost
MILVUS_COLLECTION_NAME=knowledge_chunks
EMBEDDING_DIMENSION=16
CHUNK_SIZE=450
CHUNK_OVERLAP=1
CHAT_TOP_K=3
CHAT_CONFIDENCE_THRESHOLD=0.2
OBJECT_STORAGE_ROOT=./data/object-store
