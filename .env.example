APP_NAME=Travel Ops Copilot API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AUTH_ENABLED=false
AUTH_ADMIN_TOKENS=admin-token
AUTH_OPERATOR_TOKENS=operator-token
AUTH_REVIEWER_TOKENS=reviewer-token

POSTGRES_DB=travel_ops
POSTGRES_USER=travel_ops
POSTGRES_PASSWORD=travel_ops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://travel_ops:travel_ops@localhost:5432/travel_ops

REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=knowledge
MINIO_SECURE=false

ETCD_PORT=2379
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
ATTU_PORT=18000
VECTOR_STORE_PROVIDER=milvus
MILVUS_HOST=localhost
MILVUS_COLLECTION_NAME=knowledge_chunks
# P6: Milvus 2.5+ native BM25. Off by default. When true, the collection
# schema gains a content VARCHAR + sparse_vector field bound by a BM25
# Function — Milvus tokenizes + computes BM25 weights server-side,
# replacing the SQL ILIKE lexical path. Migration steps:
#   1. set MILVUS_BM25_ENABLED=true
#   2. run `python backend/scripts/migrate_to_bm25.py --confirm`
#   3. set LEXICAL_BACKEND=milvus_bm25
#   4. run the eval gate to confirm no regression
MILVUS_BM25_ENABLED=false
# Tokenizer for the BM25 analyzer. jieba for Chinese corpora, standard
# for English / multi-lingual. Only consulted when MILVUS_BM25_ENABLED=true.
MILVUS_BM25_TOKENIZER=jieba
# Lexical retrieval backend toggle. `ilike` keeps the legacy PostgreSQL
# ILIKE + phrase-bonus scorer. `milvus_bm25` routes through Milvus' native
# sparse BM25 (requires MILVUS_BM25_ENABLED=true + migrated collection).
LEXICAL_BACKEND=ilike
# P7 Phase A: mixed-domain policy supervisor execution mode.
#   serial   — legacy for-loop over planned profiles (default)
#   parallel — LangGraph Send fan-out, one worker per profile, joined
#              by a reducer barrier. Industry-mainstream "Orchestrator-
#              Worker" pattern (LinkedIn SQL agent / Klarna customer
#              service / Uber Genie use the same shape). Output is
#              bit-identical to serial mode.
AGENT_MIXED_EXECUTION=serial
# P7 Phase B: LLM-driven ReAct planner inside policy_graph.
# When False (default), the plan node uses the legacy hardcoded
# "no obs -> call policy_search; otherwise finalize" decision (zero
# LLM cost, deterministic). When True, an LLM picks the next action
# each cycle, enabling real multi-tool / multi-cycle ReAct.
# Watch eval gate's judge_cost_usd_total — multi-cycle ReAct can spend
# 3-5x more tokens per question. Any LLM error falls back to hardcoded.
AGENT_REACT_LLM_ENABLED=false
# Hard cap on ReAct cycles; matches policy_graph.MAX_REACT_STEPS so a
# single env var can lower / raise the budget when LLM is enabled.
AGENT_REACT_MAX_STEPS=8
# P7 Phase C: agent-as-tool registration. When True, a ``call_agent``
# Tool is registered at startup (lets one agent invoke another
# mid-execution) and added to the ReAct planner's allow-list. Off by
# default because it widens blast radius. Capped by depth guard so an
# agent loop costs at most agent_as_tool_max_depth * single-agent cost.
AGENT_AS_TOOL_ENABLED=false
# Maximum nested call_agent depth per request. The (max+1)th call
# returns a failed verdict instead of recursing further.
AGENT_AS_TOOL_MAX_DEPTH=3

# --- Observability (P8) -----------------------------------------------------
# OTEL OTLP/HTTP exporter endpoint. Empty = no-op tracer (deterministic
# in-memory spans, no network). Pointing at the bundled Phoenix container:
# Three convenience paths (any combo works, dual-export supported):
#
# 1) Local Phoenix (free, self-hosted, OSS OpenInference-native UI):
#      docker compose up -d phoenix
#      PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
#      → open http://localhost:6006
#
# 2) LangSmith (paid SaaS, hosted by LangChain Inc., richer collaboration):
#      LANGSMITH_API_KEY=lsv2_pt_xxxxx           # from smith.langchain.com
#      LANGSMITH_PROJECT=cl-agent-prod           # optional; defaults to cl-agent
#      → endpoint + x-api-key header auto-built
#
# 3) Raw OTLP escape hatch (Jaeger / Tempo / Datadog / any OTLP/HTTP target):
#      OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector/v1/traces
#      OTEL_EXPORTER_OTLP_HEADERS=DD-API-KEY=xxx
#
# Master switch: auto = derive from whichever above is filled in (default);
# explicit values (`phoenix` / `langsmith` / `both` / `none`) override the
# auto-derive. `none` is the CI kill switch.
TRACING_BACKEND=auto

# Phoenix profile (path 1)
PHOENIX_ENDPOINT=
# Container ports (only consumed by docker-compose, not the backend)
PHOENIX_HTTP_PORT=6006
PHOENIX_GRPC_PORT=4317

# LangSmith profile (path 2)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cl-agent
# Override only if pointing at a private LangSmith deployment
LANGSMITH_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces

# Raw OTLP escape hatch (path 3)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=travel-ops-copilot
LLM_PROVIDER=deterministic
LLM_MODEL_NAME=deterministic-policy-client
LLM_API_BASE_URL=
LLM_API_KEY=
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL_NAME=deterministic-hash-embedding
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=16
# DashScope / 百炼 text-embedding-v4 当前批量上限为 10，接入该网关时请保持 <= 10
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=2
CHUNK_SIZE=450
CHUNK_OVERLAP=1
# 以下业务默认值可被“系统设置”面板中的数据库配置即时覆盖。
CHAT_TOP_K=3
CHAT_CONFIDENCE_THRESHOLD=0.2
OBJECT_STORAGE_ROOT=./data/object-store

# --- LLM-as-judge for /api/evals (P0) -----------------------------------
# When enabled, eval runs additionally ask an LLM to grade
# answer_correctness + faithfulness instead of relying on keyword
# AND-matching alone. Requires LLM_PROVIDER=openai-compatible plus a
# valid LLM_API_BASE_URL / LLM_API_KEY. Disabled by default so dev
# without a real gateway keeps the legacy behaviour.
EVAL_JUDGE_ENABLED=false
# Empty → reuses LLM_MODEL_NAME. Override to use a cheaper / stricter
# model for grading than the one used to generate answers.
EVAL_JUDGE_MODEL_NAME=
EVAL_JUDGE_TIMEOUT_SECONDS=20.0
# P2: judge cost reporting. Both default to 0 (cost reporting opt-in).
# Set to your gateway's published rates so eval runs can surface
# judge_cost_usd_total. Example for DeepSeek-v3.2:
#   EVAL_JUDGE_PRICE_PROMPT_PER_1K_USD=0.00027
#   EVAL_JUDGE_PRICE_COMPLETION_PER_1K_USD=0.00109
EVAL_JUDGE_PRICE_PROMPT_PER_1K_USD=0.0
EVAL_JUDGE_PRICE_COMPLETION_PER_1K_USD=0.0
