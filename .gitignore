# Python
__pycache__/
.pytest_cache/
.venv/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.pyc
backend/.pytest_cache/
backend/.ruff_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Logs and runtime artifacts
*.log
logs/
backend-start.log
backend-start.err.log
frontend-start.log
frontend-start.err.log

# Local runtime data (object-store cache, ingestion temp files, etc.)
# NOTE: keep this narrow — backend/data/eval/ holds versioned eval datasets
# and must stay in source control. Add new runtime subdirs explicitly.
/data/
backend/data/object-store/
backend/data/uploads/
backend/data/cache/

# Environment files
# - .env, .env.local, .env.*.local always contain real secrets and must stay local.
# - .env.example is the committed placeholder template (allow-listed below).
.env
.env.local
.env.*.local
!.env.example
frontend/.env
frontend/.env.local

# Editor / OS
~$*.docx
.DS_Store
Thumbs.db
.vscode/
.idea/
