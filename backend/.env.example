# Travel Ops Copilot — environment template
#
# Setup:
#   cp backend/.env.example backend/.env.local
#   # then edit .env.local with real values; it is gitignored.
#
# Precedence (highest first):
#   1. Real shell / Docker / CI environment variables
#   2. .env.local          (per-developer, gitignored, secrets live here)
#   3. .env                (shared committed defaults, optional)
#
# Keys marked [PROD-REQUIRED] MUST be overridden when APP_ENV=production
# or the app refuses to boot (see _validate_production_security in main.py).

# =========================================================================
# Application
# =========================================================================
APP_NAME="Travel Ops Copilot API"
APP_ENV=development                    # development / test / integration / production
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================================================================
# Auth — static tokens (legacy path, kept for dev convenience)
# =========================================================================
# [PROD-REQUIRED] rotate these once. Default values are rejected in prod.
AUTH_ENABLED=false
AUTH_ADMIN_TOKENS=admin-token
AUTH_OPERATOR_TOKENS=operator-token
AUTH_REVIEWER_TOKENS=reviewer-token

# =========================================================================
# Auth — JWT (P1.1)
# =========================================================================
# [PROD-REQUIRED] JWT_ENABLED=true and JWT_SECRET_KEY overridden.
JWT_ENABLED=false
JWT_SECRET_KEY=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=travel-ops-copilot
JWT_AUDIENCE=travel-ops-copilot-api
JWT_EXPIRE_MINUTES=60
# [PROD-REQUIRED] must be false so attackers cannot self-sign any tenant.
JWT_DEV_TOKEN_ENDPOINT_ENABLED=true

# =========================================================================
# Database (PostgreSQL)
# =========================================================================
DATABASE_URL=postgresql+psycopg://travel_ops:travel_ops@localhost:5432/travel_ops

# =========================================================================
# Object storage (MinIO / S3-compatible)
# =========================================================================
OBJECT_STORAGE_PROVIDER=minio          # minio or local
OBJECT_STORAGE_ROOT=./data/object-store
MINIO_ENDPOINT=localhost:9000
# [PROD-REQUIRED] both default values are rejected in prod.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=knowledge
MINIO_SECURE=false

# =========================================================================
# Vector store (Milvus)
# =========================================================================
VECTOR_STORE_PROVIDER=milvus           # milvus or noop
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=knowledge_chunks

# =========================================================================
# Embedding gateway
# =========================================================================
EMBEDDING_PROVIDER=deterministic       # deterministic or openai-compatible
EMBEDDING_MODEL_NAME=deterministic-hash-embedding
EMBEDDING_API_BASE_URL=
# [PROD-REQUIRED when provider != deterministic]
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=16
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=2
EMBEDDING_ENCODING_FORMAT=float

# =========================================================================
# LLM gateway
# =========================================================================
LLM_PROVIDER=deterministic             # deterministic or openai-compatible
LLM_MODEL_NAME=deterministic-policy-client
LLM_API_BASE_URL=
# [PROD-REQUIRED when provider != deterministic]
LLM_API_KEY=

# =========================================================================
# RAG knobs
# =========================================================================
CHUNK_SIZE=450
CHUNK_OVERLAP=1
CHAT_TOP_K=3
CHAT_CONFIDENCE_THRESHOLD=0.2
RAG_DENSE_CANDIDATE_MULTIPLIER=3
RAG_LEXICAL_CANDIDATE_MULTIPLIER=12
RAG_RRF_K=60
RAG_MAX_CHUNKS_PER_DOCUMENT=2

# =========================================================================
# Celery
# =========================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true          # true in dev/test; false in prod

# =========================================================================
# Rate limiting (P1.6)
# =========================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT_ASK=20/minute
RATE_LIMIT_KNOWLEDGE_UPLOAD=10/minute
RATE_LIMIT_AUTH_DEV_TOKEN=10/minute
